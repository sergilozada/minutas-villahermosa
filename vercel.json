{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["gru1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{static/**,config/**,templates/**}"
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api"
    }
  ]
}
