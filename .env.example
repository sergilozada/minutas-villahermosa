# Desarrollo local (SQLite)
VH_HOST=127.0.0.1
VH_PORT=8000
VH_COOKIE_SECURE=0
VH_DATABASE_PATH=data/villahermosa.db

# Producción Vercel + Supabase. Déjalo vacío en desarrollo local.
# Usa la URL del transaction pooler de Supabase (puerto 6543).
DATABASE_URL=

VH_ADMIN_EMAIL=admin@villahermosa.com
# Define secretos únicos de al menos 16 caracteres en el proveedor.
# Nunca escribas valores reales en este archivo versionado.
VH_ADMIN_PASSWORD=
VH_ASESOR_EMAIL=asesor@villahermosa.com
VH_ASESOR_PASSWORD=

VH_SESSION_TTL_SECONDS=36000
VH_MAX_MINUTES_PER_USER=5000
